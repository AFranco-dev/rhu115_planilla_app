<!DOCTYPE html>
<html>

  <%- include("partials/head") %>
  <%- include("partials/body-open") %>
  <%- include("partials/navbar") %>
  
  <section class="hero-section text-white" style="background: linear-gradient(135deg, #0c4c8a 0%, #1a73e8 100%);">
    <div class="container py-5 text-center">
      <div class="row justify-content-center">
        <div class="col-lg-8">
          <h1 class="display-4 fw-bold mb-3">Tech Dev S.A. de C.V.</h1>
          <p class="lead mb-4">Sistema de gestión de recursos humanos para el desarrollo de talento y administración de personal.</p>
          <div class="d-flex gap-3 justify-content-center">
            <a href="/empleados" class="btn btn-light px-4 py-2 shadow-sm">
              <i class="fas fa-users me-2"></i> Ver Empleados
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="custom-shape-divider">
      <svg data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
        <path d="M600,112.77C268.63,112.77,0,65.52,0,7.23V120H1200V7.23C1200,65.52,931.37,112.77,600,112.77Z" class="shape-fill"></path>
      </svg>
    </div>
  </section>
  <section class="py-5 mt-5">
    <div class="container">
      <h2 class="text-center mb-5 fw-bold">Gestión de Personal Simplificada</h2>
      <div class="row g-5 justify-content-center">
        <div class="col-md-4 text-center">
          <div class="feature-icon mx-auto shadow-sm">
            <i class="fas fa-users-cog"></i>
          </div>
          <h5 class="mt-4 fw-bold">Administración de Empleados</h5>
          <p class="text-muted">Gestione fácilmente la información de sus empleados en un solo lugar.</p>
        </div>
        <div class="col-md-4 text-center">
          <div class="feature-icon mx-auto shadow-sm">
            <i class="fas fa-calculator"></i>
          </div>
          <h5 class="mt-4 fw-bold">Cálculo de Planillas</h5>
          <p class="text-muted">Automatice el cálculo de salarios, retenciones e impuestos de manera precisa.</p>
        </div>
        <div class="col-md-4 text-center">
          <div class="feature-icon mx-auto shadow-sm">
            <i class="fas fa-chart-line"></i>
          </div>
          <h5 class="mt-4 fw-bold">Reportes y Estadísticas</h5>
          <p class="text-muted">Obtenga informes detallados y analice el rendimiento de su equipo.</p>
        </div>
      </div>
    </div>
  </section>


  <section class="py-5 bg-light">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-lg-8 text-center">
          <h2 class="mb-3 fw-bold">¿Listo para comenzar?</h2>
          <p class="lead mb-4">Comience ahora a gestionar su personal de manera eficiente.</p>
          <a href="/empleados" class="btn btn-primary px-4 py-2 shadow">
            <i class="fas fa-rocket me-2"></i> Comenzar Ahora
          </a>
        </div>
      </div>
    </div>
  </section>

  <style>
    .hero-section {
      position: relative;
      padding-top: 5rem;
      padding-bottom: 6rem;
    }
    
    .custom-shape-divider {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      overflow: hidden;
      line-height: 0;
    }
    
    .custom-shape-divider svg {
      position: relative;
      display: block;
      width: 100%;
      height: 50px;
    }
    
    .custom-shape-divider .shape-fill {
      fill: #FFFFFF;
    }
    
    .feature-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 80px;
      height: 80px;
      border-radius: 50%;
      font-size: 1.8rem;
      background: linear-gradient(135deg, #0c4c8a 0%, #1a73e8 100%);
      color: white;
      transition: transform 0.3s ease;
    }
    
    .feature-icon:hover {
      transform: translateY(-5px);
    }
    
    .btn {
      border-radius: 30px;
      font-weight: 500;
      transition: all 0.3s ease;
    }
    
    .btn-outline-light:hover {
      background-color: rgba(255, 255, 255, 0.2);
    }
    
    .btn-primary {
      background: linear-gradient(135deg, #0c4c8a 0%, #1a73e8 100%);
      border: none;
    }
    
    .btn-primary:hover {
      background: linear-gradient(135deg, #0a4378 0%, #1667d2 100%);
      transform: translateY(-2px);
    }
    
    h2 {
      color: #0c4c8a;
    }
    
    h5 {
      color: #0c4c8a;
    }
  </style>
  
  <!-- prettier-ignore -->
  <%- include("partials/footer") %>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Verificar y corregir enlaces de botones
      const botones = document.querySelectorAll('.btn');
      botones.forEach(boton => {
        boton.addEventListener('click', function(e) {
          const href = this.getAttribute('href');
          if (href && href !== '#') {
            window.location.href = href;
          }
        });
      });
    });
  </script>
  
  <%- include("partials/body-close") %>
</html>