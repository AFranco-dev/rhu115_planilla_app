<!DOCTYPE html>
<html>
  <!-- prettier-ignore -->
  <%- include("../partials/head") %>
  <%- include("../partials/body-open") %>
  <%- include("../partials/navbar") %>
  <%- include("../partials/main-open") %>
  <%- include("../partials/flash-success") %>

  <div class="container py-5">
    <div class="row justify-content-center">
      <div class="col-md-7">
        <div class="register-container">
          <div class="register-header text-center mb-4">
            <h2 class="fw-bold">Crear cuenta</h2>
            <p class="text-muted">Complete el formulario para registrarse</p>
          </div>
          
          <form class="needs-validation" action="/register" method="POST" novalidate>
            <div class="mb-3">
              <label for="username" class="form-label">Nombre de usuario</label>
              <div class="input-group">
                <span class="input-group-text bg-white border-end-0">
                  <i class="fas fa-user text-muted"></i>
                </span>
                <input
                  required
                  placeholder="Ingrese su nombre de usuario"
                  name="username"
                  id="username"
                  class="form-control border-start-0"
                />
              </div>
              <div class="invalid-feedback">Por favor ingrese un nombre de usuario válido.</div>
            </div>
            
            <div class="mb-3">
              <label for="email" class="form-label">Correo electrónico</label>
              <div class="input-group">
                <span class="input-group-text bg-white border-end-0">
                  <i class="fas fa-envelope text-muted"></i>
                </span>
                <input
                  required
                  placeholder="ejemplo@correo.com"
                  name="email"
                  id="email"
                  type="email"
                  class="form-control border-start-0"
                />
              </div>
              <div class="invalid-feedback">Por favor ingrese un correo electrónico válido.</div>
            </div>
            
            <div class="mb-3">
              <label for="password" class="form-label">Contraseña</label>
              <div class="input-group">
                <span class="input-group-text bg-white border-end-0">
                  <i class="fas fa-lock text-muted"></i>
                </span>
                <input
                  required
                  placeholder="Cree una contraseña segura"
                  name="password"
                  id="password"
                  type="password"
                  class="form-control border-start-0"
                />
                <button class="btn bg-white border border-start-0" type="button" id="togglePassword">
                  <i class="fas fa-eye text-muted"></i>
                </button>
              </div>
              <div class="form-text mt-1">
                <small><i class="fas fa-info-circle"></i> La contraseña debe tener al menos 8 caracteres.</small>
              </div>
              <div class="invalid-feedback">Por favor cree una contraseña.</div>
            </div>
            
            <div class="mb-4">
              <div class="form-check">
                <input class="form-check-input" type="checkbox" value="" id="agreeTerms" required>
                <label class="form-check-label" for="agreeTerms">
                  Acepto los <a href="#" class="text-decoration-none register-link">términos y condiciones</a>
                </label>
                <div class="invalid-feedback">
                  Debe aceptar los términos y condiciones para continuar.
                </div>
              </div>
            </div>
            
            <div class="d-grid">
              <button class="btn btn-lg fw-bold py-2 register-btn" type="submit">
                Crear cuenta
              </button>
            </div>
            
            <div class="text-center mt-4">
              <span>¿Ya tiene una cuenta?</span>
              <a href="/login" class="text-decoration-none fw-bold register-link ms-1">Iniciar sesión</a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <style>
    .register-container {
      background-color: #fff;
      border-radius: 10px;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
      padding: 40px;
    }
    
    .register-header h2 {
      color: #333;
    }
    
    .input-group-text {
      border-radius: 6px 0 0 6px;
    }
    
    .form-control {
      border-radius: 0 6px 6px 0;
    }
    
    .form-control:focus, 
    .input-group-text:focus, 
    .btn:focus {
      box-shadow: none;
      border-color: #004080;
    }
    
    .register-btn {
      background-color: #004080;
      color: white;
      border-radius: 6px;
      transition: all 0.3s ease;
    }
    
    .register-btn:hover {
      background-color: #003366;
      transform: translateY(-1px);
    }
    
    .form-check-input:checked {
      background-color: #004080;
      border-color: #004080;
    }
    
    .register-link {
      color: #004080;
    }
    
    /* Responsive adjustments */
    @media (max-width: 768px) {
      .register-container {
        padding: 30px 20px;
      }
    }
  </style>


  <%- include("../partials/main-close") %>
  
  <script>
    (() => {
      "use strict";

      const forms = document.querySelectorAll(".needs-validation");
      Array.from(forms).forEach((form) => {
        form.addEventListener(
          "submit",
          (event) => {
            if (!form.checkValidity()) {
              event.preventDefault();
              event.stopPropagation();
            }
            form.classList.add("was-validated");
          },
          false
        );
      });
      
      // Toggle password visibility
      const togglePassword = document.querySelector('#togglePassword');
      const password = document.querySelector('#password');
      
      togglePassword.addEventListener('click', function () {
        const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
        password.setAttribute('type', type);
        this.querySelector('i').classList.toggle('fa-eye');
        this.querySelector('i').classList.toggle('fa-eye-slash');
      });
    })();
  </script>
  
  <!-- prettier-ignore -->
  <%- include("../partials/footer") %>
  <%- include("../partials/body-close") %>
</html>